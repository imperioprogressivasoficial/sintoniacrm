# Copie para .env e preencha. Nunca faça commit do .env.

PORT=3333
# Banco da Sintonia (Postgres). Sem ele, os dados ficam só em memória.
DATABASE_URL=postgres://sintonia:SENHA@127.0.0.1:5432/sintonia
# Fuso de todas as regras de horário (Bahia não tem horário de verão)
TZ=America/Bahia

# --- Login ---
# Cookie só por HTTPS (deixe 1 em produção; 0 só em teste local sem HTTPS)
COOKIE_SEGURO=1
# Primeiro administrador, criado ao subir se não existir (senha: 10+ caracteres, letras e números)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# Modelo do agente. Padrão: claude-opus-5-5
SINTONIA_MODELO=claude-opus-5-5
# Esforço do agente no WhatsApp (low | medium | high). Conversa curta pede "low".
SINTONIA_ESFORCO=low

# --- WhatsApp não oficial (Evolution API, já roda no VPS) ---
EVOLUTION_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=
# Token que a Evolution manda no cabeçalho "x-sintonia-token" ao chamar o webhook
EVOLUTION_WEBHOOK_TOKEN=

# --- WhatsApp oficial (Meta Cloud API) — Fase 3 ---
META_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- Trinks ---
TRINKS_API_KEY=
# Pausa mínima entre chamadas ao Trinks (ms). A cota é compartilhada com o cashback.
TRINKS_INTERVALO_MS=1200

# --- Relatório diário ---
# Números que recebem o resumo das 20h (com DDI, separados por vírgula)
RELATORIO_DESTINOS=

# --- Números conectados ---
# canalId = nome da instância na Evolution (ou phone_number_id na Meta)
SINTONIA_NUMEROS=[{"canalId":"imperio-teste","unidade":"norte","canal":"evolution"}]
SINTONIA_EMPRESA_ID=imperio
